<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Unirse al club</title>
</head>
<body>
    <h1>Unete al Club Secreto</h1>
    <p>Ingresa la contraseña secreta para convertirte en miembro:</p>
    <form action="/join-club" method="POST">
        <label for="secret_code">Contraseña Secreta:</label>
        <input type="password" id="secret_code" name="secret_code" required>
        <button type="submit">Unirse</button>
    </form>
</body>
</html>